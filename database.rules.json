{
  "rules": {
    "hostKeys": {
      ".read": false,
      ".write": false
    },

    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('hostKeys').child(newData.child('key').val()).val() === newData.child('role').val())",
        ".validate": "newData.hasChildren(['key', 'role'])",
        "key": { ".validate": "newData.isString() && newData.val().length >= 12 && newData.val().length <= 64 && newData.val().matches(/^[a-z0-9]+(-[a-z0-9]+)(-[a-z0-9]+)+$/)" },
        "role": { ".validate": "newData.val() === 'host' || newData.val() === 'screen'" },
        "$other": { ".validate": false }
      }
    },

    "state": {
      ".read": true,
      ".write": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      ".validate": "newData.hasChild('phase')",
      "phase": { ".validate": "newData.isString() && newData.val().matches(/^(idle|speeches|open|closed|revealed)$/)" },
      "current": { ".validate": "newData.isString()" },
      "speaker": { ".validate": "newData.isString()" },
      "$other": { ".validate": false }
    },

    "contests": {
      ".read": true,
      ".write": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      "$contest": {
        ".validate": "newData.hasChild('title')",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "order": { ".validate": "newData.isNumber()" },
        "allowAbstain": { ".validate": "newData.isBoolean()" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending|speeches|open|closed|revealed)$/)" },
        "winner": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)" },
        "candidates": {
          "$cand": {
            ".validate": "newData.hasChild('name')",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "codes": {
      ".read": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      ".write": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      "$code": {
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.val() === true"
      }
    },

    "claims": {
      ".read": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('codes').child($code).val() === true",
        ".validate": "newData.isString() && $code.matches(/^[A-HJ-NP-Z2-9]{6}$/)"
      }
    },

    "votes": {
      ".read": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).exists()",
      ".write": "auth != null && root.child('sessions').child(auth.uid).child('key').exists() && root.child('hostKeys').child(root.child('sessions').child(auth.uid).child('key').val()).val() === 'host'",
      "$contest": {
        "$code": {
          ".read": "auth != null && root.child('claims').child($code).val() === auth.uid",
          ".write": "auth != null && !data.exists() && root.child('claims').child($code).val() === auth.uid && root.child('state/current').val() === $contest && root.child('state/phase').val() === 'open' && ((newData.val() === 'abstain' && root.child('contests').child($contest).child('allowAbstain').val() === true) || root.child('contests').child($contest).child('candidates').child(newData.val()).child('name').exists())",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)"
        }
      }
    }
  }
}
